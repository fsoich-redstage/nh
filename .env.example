# Green API
GREEN_API_URL=https://7105.api.greenapi.com
GREEN_API_INSTANCE_ID=
GREEN_API_TOKEN=

# Shared secret required as ?token= on the webhook URL. Generate one (e.g.
# `openssl rand -hex 24`) and configure Green API's webhookUrl as
# https://tu-dominio/webhook.php?token=<este-valor>. The webhook refuses to
# run at all if this is left empty.
GREEN_API_WEBHOOK_TOKEN=

# Optional: Slack/Discord/etc incoming webhook URL notified by
# bin/check_instance_health.php when the WhatsApp session disconnects.
NUTRI_HEALTH_ALERT_WEBHOOK_URL=

# Admin panel (public/admin/) — HTTP Basic Auth. Generate the hash with:
#   php -r "echo password_hash('tu-password', PASSWORD_DEFAULT);"
# The panel refuses to serve anything if either is empty.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# OpenAI
OPENAI_API_KEY=

# MySQL
DB_HOST=localhost
DB_USER=
DB_PASSWORD=
DB_NAME=my_db

# Rutas / app
# NUTRI_IMAGE_DIR debe ser una carpeta servida públicamente por el webserver
# (igual que en producción: las fotos se ven por URL directa, ej. /photos/xxx.jpg).
NUTRI_IMAGE_DIR=/absolute/path/to/nutri-helper/public/photos
NUTRI_IMAGE_PUBLIC_PATH=/photos
NUTRI_LANDING_BASE_URL=https://nutrihelper.com.ar

# Link de WhatsApp mostrado en la landing promocional (identifier inválido o sin comidas aún).
# Ej: https://wa.me/<numero>?text=<mensaje-urlencoded>
NUTRI_BOT_WHATSAPP_LINK=

# Hora local (America/Argentina/Buenos_Aires) en la que bin/send_daily_summary.php
# efectivamente manda el resumen de fin de día (el cron puede correr cada hora, el
# script decide internamente si es la hora configurada).
NUTRI_DAILY_SUMMARY_HOUR=22
